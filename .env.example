# ── System One reviewer ──────────────────────────────────────────────
# Without SYSTEMONE_MODEL only the well-known pattern checks run.

# Reviewer model.
#   opencode backend: "<provider>/<model>[#variant]" from your OpenCode providers
#   http backend:     the model id your endpoint expects
SYSTEMONE_MODEL=

# API key for the reviewer endpoint. Setting it selects the http backend
# (OpenAI-compatible; default endpoint https://api.openai.com/v1).
# Read once at startup and removed from the environment, so agent shells never see it.
SYSTEMONE_API_KEY=

# OpenAI-compatible endpoint (setting it also selects the http backend).
# Examples: https://openrouter.ai/api/v1, https://api.groq.com/openai/v1, http://localhost:11434/v1 (Ollama)
SYSTEMONE_BASE_URL=

# Force a backend: opencode | http. Default: http if SYSTEMONE_API_KEY or SYSTEMONE_BASE_URL is set, else opencode.
# SYSTEMONE_BACKEND=

# ── Behaviour ────────────────────────────────────────────────────────
SYSTEMONE_ENABLED=true
SYSTEMONE_TIMEOUT_MS=15000
# allow | escalate | deny — what to do when the reviewer fails or times out
SYSTEMONE_FAIL_MODE=escalate
# Block "deny" verdicts without asking (default: ask the human for every flagged action)
SYSTEMONE_HARD_DENY=false
# Send the model's reasoning for the current turn to the reviewer (redacted)
SYSTEMONE_REVIEW_REASONING=true
# Max wait for still-streaming reasoning before reviewing a call
SYSTEMONE_REASONING_WAIT_MS=500
# Skip the model call when a well-known pattern already says deny
SYSTEMONE_SHORT_CIRCUIT=true
# Comma-separated tools that bypass review entirely (e.g. "todowrite")
SYSTEMONE_SKIP_TOOLS=
SYSTEMONE_REDACT_OUTPUT=true
# JSONL audit trail of every verdict and human decision (unset = off)
SYSTEMONE_AUDIT_LOG=
# Review tool OUTPUT for prompt injection before the agent reads it (one extra reviewer call per result)
SYSTEMONE_REVIEW_OUTPUT=false
SYSTEMONE_MAX_OUTPUT_CHARS=20000
SYSTEMONE_MAX_INPUT_CHARS=16000
# debug | info | warn | error
SYSTEMONE_LOG_LEVEL=info
